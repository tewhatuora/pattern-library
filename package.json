{
  "name": "healthnz",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "yarn workspace @healthnz/pattern-library-themes build && yarn workspace @healthnz/pattern-library build",
    "start": "yarn workspace example start",
    "lint": "eslint --cache",
    "lint:fix": "yarn lint --fix",
    "lint:format": "prettier --write packages/**/*.{js,ts,tsx}",
    "lint:types": "yarn workspaces run lint:types",
    "postinstall": "husky install",
    "size": "yarn build && yarn size-limit",
    "test": "yarn workspaces foreach -p run test",
    "storybook": "storybook dev -p 9009",
    "build-storybook": "NODE_OPTIONS=--max_old_space_size=4096 && storybook build",
    "chromatic": "chromatic"
  },
  "lint-staged": {
    "*.{js,mdx,ts,tsx}": [
      "yarn lint:format",
      "yarn lint:fix",
      "yarn lint:types"
    ],
    "*.{json,md,yml}": [
      "yarn lint:format"
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.17.9",
    "@chromatic-com/storybook": "^3",
    "@next/eslint-plugin-next": "^12.1.6",
    "@prettier/plugin-xml": "^1.2.0",
    "@size-limit/preset-big-lib": "^11.1.6",
    "@storybook/addon-actions": "^8.4.1",
    "@storybook/addon-essentials": "^8.4.1",
    "@storybook/addon-interactions": "^8.4.1",
    "@storybook/addon-links": "^8.4.1",
    "@storybook/addon-mdx-gfm": "^8.4.1",
    "@storybook/addon-themes": "^8.4.1",
    "@storybook/builder-vite": "^8.4.1",
    "@storybook/react": "^8.4.1",
    "@storybook/react-vite": "^8.4.1",
    "@storybook/test": "^8.4.1",
    "@storybook/theming": "^8.4.1",
    "@svgr/babel-plugin-remove-jsx-attribute": "^6.0.0",
    "@svgr/cli": "^6.4.0",
    "@svgr/core": "^6.4.0",
    "@types/dedent": "^0.7.0",
    "@types/fs-extra": "^9.0.13",
    "@types/glob": "^7.2.0",
    "@types/mdx": "^2.0.2",
    "@types/react": "^18",
    "@typescript-eslint/eslint-plugin": "^5.27.0",
    "@typescript-eslint/parser": "^5.27.0",
    "@vanilla-extract/webpack-plugin": "^2.1.10",
    "babel-loader": "^8.2.4",
    "change-case": "^4.1.2",
    "chromatic": "^6.9.0",
    "dedent": "^0.7.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^12.1.6",
    "eslint-config-prettier": "^8.5.0",
    "eslint-config-react-app": "^7.0.1",
    "eslint-import-resolver-typescript": "^2.7.1",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-jest": "^26.4.6",
    "eslint-plugin-mdx": "^2.0.5",
    "eslint-plugin-prettier": "^4.0.0",
    "eslint-plugin-react": "^7.30.0",
    "eslint-plugin-react-hooks": "^4.5.0",
    "fs-extra": "^10.0.0",
    "glob": "^7.2.0",
    "husky": "^8.0.0",
    "json-to-ts": "^1.7.0",
    "lint-staged": "13.0.0",
    "prettier": "^2.4.1",
    "prompt": "^1.2.0",
    "react": "18",
    "react-docgen": "^5.4.3",
    "size-limit": "^11.1.6",
    "storybook": "^8.4.1",
    "storybook-preset-inline-svg": "^1.0.1",
    "style-dictionary": "^3.7.0",
    "svg-inline-loader": "^0.8.2",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@healthnz/pattern-library": ">=0.9.0",
    "@healthnz/pattern-library-themes": ">=0.9.0",
    "@storybook/addon-docs": "^8.4.1",
    "@uiw/react-json-view": "^2.0.0-alpha.32",
    "vite": "^5.4.19",
    "vite-plugin-dts": "^4.5.4",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "packageManager": "yarn@4.5.1"
}
