{
  "name": "healthnz",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "yarn workspace @healthnz/pattern-library-themes build && yarn workspace @healthnz/pattern-library build",
    "start": "yarn workspace example start",
    "lint": "eslint --cache .",
    "lint:fix": "yarn lint --fix",
    "lint:format": "prettier --write .",
    "lint:types": "yarn workspaces foreach -A --include 'packages/*' run lint:types",
    "postinstall": "husky",
    "storybook": "storybook dev -p 9009",
    "build-storybook": "NODE_OPTIONS=--max_old_space_size=4096 && storybook build",
    "chromatic": "chromatic"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.5.1",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/addon-links": "^10.6.2",
    "@storybook/addon-themes": "^10.6.2",
    "@storybook/react-vite": "^10.6.2",
    "@types/mdx": "^2.0.2",
    "@types/react": "^18",
    "@uiw/react-json-view": "^2.0.0-alpha.32",
    "@vanilla-extract/css": "^1.21.0",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "chromatic": "^18.13.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-mdx": "^3.8.1",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "react": "18",
    "storybook": "^10.6.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vite-plugin-dts": "^5.1.2",
    "vite-plugin-svgr": "^5.2.0"
  },
  "dependencies": {
    "@healthnz/pattern-library": ">=0.9.0",
    "@healthnz/pattern-library-themes": ">=0.9.0"
  },
  "packageManager": "yarn@4.18.1"
}
