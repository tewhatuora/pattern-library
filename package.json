{
  "name": "te-whatu-ora",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "yarn workspace @te-whatu-ora/anatomic-themes build && yarn workspace @te-whatu-ora/anatomic build",
    "start": "yarn workspace example start",
    "lint": "eslint --cache",
    "lint:fix": "yarn lint --fix",
    "lint:format": "prettier --write",
    "lint:types": "yarn workspaces run lint:types",
    "postinstall": "husky install",
    "size": "yarn build && yarn size-limit",
    "test": "yarn workspaces foreach -p run test",
    "storybook": "start-storybook -p 9009",
    "build-storybook": "NODE_OPTIONS=--max_old_space_size=4096 && build-storybook",
    "chromatic": "chromatic"
  },
  "lint-staged": {
    "*.{js,mdx,ts,tsx}": [
      "yarn lint:format",
      "yarn lint:fix",
      "yarn lint:types"
    ],
    "*.{json,md,yml}": [
      "yarn lint:format"
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.17.9",
    "@next/eslint-plugin-next": "^12.1.6",
    "@prettier/plugin-xml": "^1.2.0",
    "@size-limit/preset-big-lib": "^6.0.3",
    "@storybook/addon-actions": "^6.5.10",
    "@storybook/addon-essentials": "^6.5.12",
    "@storybook/addon-interactions": "^6.5.12",
    "@storybook/addon-links": "^6.5.12",
    "@storybook/addons": "^6.5.12",
    "@storybook/builder-vite": "0.1.41",
    "@storybook/react": "^6.5.12",
    "@storybook/testing-library": "^0.0.13",
    "@storybook/theming": "^6.5.12",
    "@svgr/babel-plugin-remove-jsx-attribute": "^6.0.0",
    "@svgr/cli": "^6.4.0",
    "@svgr/core": "^6.4.0",
    "@types/dedent": "^0.7.0",
    "@types/fs-extra": "^9.0.13",
    "@types/glob": "^7.2.0",
    "@types/mdx": "^2.0.2",
    "@typescript-eslint/eslint-plugin": "^5.27.0",
    "@typescript-eslint/parser": "^5.27.0",
    "@vanilla-extract/webpack-plugin": "^2.1.10",
    "babel-loader": "^8.2.4",
    "change-case": "^4.1.2",
    "chromatic": "^6.9.0",
    "dedent": "^0.7.0",
    "eslint": "^8.16.0",
    "eslint-config-next": "^12.1.6",
    "eslint-config-prettier": "^8.5.0",
    "eslint-config-react-app": "^7.0.1",
    "eslint-import-resolver-typescript": "^2.7.1",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-jest": "^26.4.6",
    "eslint-plugin-mdx": "^2.0.5",
    "eslint-plugin-prettier": "^4.0.0",
    "eslint-plugin-react": "^7.30.0",
    "eslint-plugin-react-hooks": "^4.5.0",
    "fs-extra": "^10.0.0",
    "glob": "^7.2.0",
    "husky": "^8.0.0",
    "json-to-ts": "^1.7.0",
    "lint-staged": "13.0.0",
    "prettier": "^2.4.1",
    "prompt": "^1.2.0",
    "react-docgen": "^5.4.3",
    "size-limit": "^6.0.3",
    "storybook-addon-themes": "^6.1.0",
    "storybook-preset-inline-svg": "^1.0.1",
    "storybook-tokens": "^1.0.1",
    "style-dictionary": "^3.7.0",
    "svg-inline-loader": "^0.8.2",
    "typescript": "4.4.4"
  },
  "engines": {
    "node": "16"
  }
}
