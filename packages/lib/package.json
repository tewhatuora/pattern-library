  "scripts": {
    "build": "vite build",
    "lint:types": "tsc --noEmit",
    "test": "jest",
    "clean": "rm -rf ../../CURRENT_VERSION.md",
    "patch": "yarn clean && standard-version --release-as patch --infile ../../CURRENT_VERSION.md --header=\"\" --commit-all --no-verify",
    "minor": "yarn clean && standard-version --release-as minor --infile ../../CURRENT_VERSION.md --header=\"\" --commit-all --no-verify",
    "major": "yarn clean && standard-version --release-as major --infile ../../CURRENT_VERSION.md --header=\"\" --commit-all --no-verify",
    "major:beta": "yarn clean && standard-version --release-as major --prerelease beta --infile ../../CURRENT_VERSION.md --header=\"\" --commit-all --no-verify"
  },
  "standard-version": {
    "scripts": {
      "precommit": "echo \"$(cat ../../CURRENT_VERSION.md ../../CHANGELOG.md)\" > ../../CHANGELOG.md && git add ../../CHANGELOG.md"
    }
  },
