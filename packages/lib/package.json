{
  "name": "@healthnz/pattern-library",
  "version": "2.0.0",
  "description": "Health NZ - Design Pattern Library",
  "homepage": "https://main--630296ff1edaa813b72e85c0.chromatic.com/",
  "author": "Kyle Beattie <kyle.beattie@alphero.com>",
  "contributors": [
    {
      "name": "Kyle Beattie",
      "email": "kyle.beattie@alphero.com"
    },
    {
      "name": "Chris Meekin",
      "email": "chris.meekin@alphero.com"
    },
    {
      "name": "Chris McArdle",
      "email": "chris.mcardle@alphero.com"
    }
  ],
  "keywords": [
    "te whatu ora",
    "health nz",
    "ui toolkit",
    "design system",
    "pattern library"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./styles": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css",
    "*.css.ts"
  ],
  "files": [
    "dist",
    "styles"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tewhatuora/pattern-library.git",
    "directory": "packages/lib"
  },
  "license": "MIT",
  "scripts": {
    "build": "vite build && vite build --mode cjs",
    "lint:types": "tsc --noEmit",
    "clean": "rm -rf ../../CURRENT_VERSION.md",
    "patch": "yarn clean && commit-and-tag-version --release-as patch --infile ../../CURRENT_VERSION.md --header=\"\" --commit-all --no-verify",
    "minor": "yarn clean && commit-and-tag-version --release-as minor --infile ../../CURRENT_VERSION.md --header=\"\" --commit-all --no-verify",
    "major": "yarn clean && commit-and-tag-version --release-as major --infile ../../CURRENT_VERSION.md --header=\"\" --commit-all --no-verify",
    "major:beta": "yarn clean && commit-and-tag-version --release-as major --prerelease beta --infile ../../CURRENT_VERSION.md --header=\"\" --commit-all --no-verify",
    "lint:package": "publint && attw --pack . --exclude-entrypoints styles --ignore-rules false-cjs false-esm internal-resolution-error"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@react-aria/button": "^3.15.1",
    "@react-aria/interactions": "^3.28.1",
    "@react-aria/label": "^3.8.1",
    "@react-aria/link": "^3.9.1",
    "@react-aria/textfield": "^3.19.1",
    "@react-aria/utils": "^3.34.1",
    "@vanilla-extract/css": "^1.21.0",
    "@vanilla-extract/dynamic": "^2.1.5",
    "@vanilla-extract/recipes": "^0.5.7",
    "@vanilla-extract/sprinkles": "^1.7.0",
    "clsx": "^2.1.1",
    "country-flag-icons": "^1.5.19",
    "csstype": "^3.1.3",
    "date-fns": "^4.1.0",
    "focus-trap-react": "^12.0.3",
    "react-phone-number-input": "^3.4.12",
    "react-shielded": "^2.2.0"
  },
  "devDependencies": {
    "@healthnz/pattern-library-themes": "*",
    "@react-types/shared": "^3.30.0",
    "@types/lodash": "^4.17.17",
    "@types/node": "^24",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vanilla-extract/css-utils": "^0.1.6",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "@vitejs/plugin-react": "^6.1.2",
    "commit-and-tag-version": "^13.3.0",
    "lodash": "^4.18.1",
    "typescript": "^5.8.3",
    "vite": "^8.3.4",
    "vite-plugin-svgr": "^5.2.0"
  },
  "peerDependencies": {
    "@healthnz/pattern-library-themes": "*",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "commit-and-tag-version": {
    "scripts": {
      "precommit": "echo \"$(cat ../../CURRENT_VERSION.md ../../CHANGELOG.md)\" > ../../CHANGELOG.md && git add ../../CHANGELOG.md"
    }
  }
}
