{
  "platforms": {
    "web": {
      "transforms": ["attribute/cti", "name/pascal", "color/css-rounded-alpha"],
      "options": {},
      "files": [
        {
          "format": "typescript/vanilla-extract-tokens",
          "destination": "tokens.ts"
