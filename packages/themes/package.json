{
  "name": "@te-whatu-ora/anatomic-themes",
  "version": "0.0.2-beta.2",
  "description": "Te Whatu Ora - Anatomic Design system. Generate multi platform design tokens using Style Dictionary",
  "keywords": [
    "te whatu ora",
    "ui toolkit",
    "design system",
    "pattern library",
    "theme"
  ],
  "author": "Kyle Beattie <kyle.beattie@alphero.com>",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/generate.js && vite build && rm -rf ./tmp",
    "test": "jest",
    "patch": "standard-version --release-as patch --skip.changelog --commit-all --path packages/themes -t @te-whatu-ora/anatomic-themes@ --no-verify",
    "minor": "standard-version --release-as minor --skip.changelog --commit-all --path packages/themes -t @te-whatu-ora/anatomic-themes@ --no-verify",
    "major": "standard-version --release-as major --skip.changelog --commit-all --path packages/themes -t @te-whatu-ora/anatomic-themes@ --no-verify"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.18.10",
    "@vanilla-extract/vite-plugin": "^3.3.0",
    "jest": "^28.1.3",
    "prettier": "^2.7.1",
    "standard-version": "^9.5.0",
    "style-dictionary": "^3.7.1",
    "tsconfig-paths": "^4.1.0",
    "vite": "^2.6.13",
    "vite-plugin-dts": "^0.9.2",
    "vite-tsconfig-paths": "^3.3.17"
  },
  "main": "./dist/index.cjs.js",
  "module": "./dist/index.es.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs.js"
    },
    "./styles": "./dist/style.css"
  },
  "sideEffects": [
    "*.css.ts"
  ],
  "files": [
    "dist/**"
  ],
  "type": "module"
}
