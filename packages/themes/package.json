{
  "name": "@healthnz/pattern-library-themes",
  "version": "2.0.0",
  "description": "Health NZ - Design Pattern Library. Generate multi platform design tokens using Style Dictionary",
  "keywords": [
    "te whatu ora",
    "health nz",
    "ui toolkit",
    "design system",
    "pattern library",
    "theme"
  ],
  "homepage": "https://main--630296ff1edaa813b72e85c0.chromatic.com/",
  "author": "Kyle Beattie <kyle.beattie@alphero.com>",
  "contributors": [
    {
      "name": "Kyle Beattie",
      "email": "kyle.beattie@alphero.com"
    },
    {
      "name": "Chris Meekin",
      "email": "chris.meekin@alphero.com"
    },
    {
      "name": "Chris McArdle",
      "email": "chris.mcardle@alphero.com"
    }
  ],
  "license": "MIT",
  "scripts": {
    "build": "node scripts/generate.js && vite build && rm -rf ./tmp",
    "lint:types": "tsc --noEmit",
    "patch": "commit-and-tag-version --release-as patch --skip.changelog --commit-all --path packages/themes -t @healthnz/pattern-library-themes@ --no-verify",
    "minor": "commit-and-tag-version --release-as minor --skip.changelog --commit-all --path packages/themes -t @healthnz/pattern-library-themes@ --no-verify",
    "major": "commit-and-tag-version --release-as major --skip.changelog --commit-all --path packages/themes -t @healthnz/pattern-library-themes@ --no-verify",
    "major:beta": "commit-and-tag-version --release-as major --prerelease beta --skip.changelog --commit-all --path packages/themes -t @healthnz/pattern-library-themes@ --no-verify",
    "lint:package": "publint && attw --pack . --exclude-entrypoints styles --ignore-rules false-cjs false-esm internal-resolution-error"
  },
  "devDependencies": {
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "commit-and-tag-version": "^13.3.0",
    "prettier": "^3.9.10",
    "style-dictionary": "^5.7.0",
    "typescript": "^5.8.3",
    "vite": "^8.3.4"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles": {
      "types": "./styles/index.d.ts",
      "default": "./dist/style.css"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css",
    "*.css.ts"
  ],
  "files": [
    "dist",
    "styles"
  ],
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tewhatuora/pattern-library.git",
    "directory": "packages/themes"
  }
}
